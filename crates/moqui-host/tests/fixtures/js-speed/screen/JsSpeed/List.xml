<?xml version="1.0" encoding="UTF-8"?>
<!-- A form-list of rowCount rows (default 20) built in the actions, with display, format, conditional and
     expanded-text fields: what each row costs. -->
<screen require-authentication="false">
    <parameter name="rowCount"/>
    <actions>
        <set field="rows" from="Number(rowCount || 20)"/>
        <script><![CDATA[
            itemList = []
            for (let i = 0; i < rows; i++) itemList.push({itemId: 'I' + i, name: 'Item ' + i, status: i % 3 == 0 ? 'DONE' : 'ACTIVE',
                price: 1.25 * i, qty: i % 7, note: i % 2 == 0 ? 'even' : ''})
        ]]></script>
    </actions>
    <widgets>
        <form-list name="ItemList" list="itemList" paginate="false">
            <field name="itemId"><default-field><display/></default-field></field>
            <field name="name"><default-field><display/></default-field></field>
            <field name="status">
                <conditional-field condition="status == 'DONE'"><display text="Done"/></conditional-field>
                <default-field><display text="Active"/></default-field>
            </field>
            <field name="price" align="right"><default-field><display format="#,##0.00"/></default-field></field>
            <field name="qty"><default-field><display/></default-field></field>
            <field name="line"><default-field><display text="${name} x ${qty}"/></default-field></field>
            <field name="note"><default-field><display/></default-field></field>
        </form-list>
    </widgets>
</screen>
