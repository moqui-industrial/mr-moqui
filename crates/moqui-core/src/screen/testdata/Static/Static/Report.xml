<?xml version="1.0" encoding="UTF-8"?>
<!-- What the compatibility report finds: each widget expression or action here does something a browser cannot. -->
<screen require-authentication="false" server-static="qvt,html">
    <always-actions><message>repeated by the form request</message></always-actions>
    <pre-actions><entity-make-value entity-name="moqui.basic.EnumerationType" value-field="made"/></pre-actions>
    <actions>
        <set field="amount" value="1.50" type="BigDecimal"/>
        <set field="tax" value="0.25" type="BigDecimal"/>
    </actions>
    <widgets>
        <label text="count ${ec.entity.find('moqui.basic.EnumerationType').count()}"/>
        <label text="sum ${amount.add(tax)}"/>
        <label text="after the violations the render goes on"/>
        <link url="." text="Here" link-type="anchor" condition="sri.getScreenUrlInstance() != null"/>
        <label text="Total ${enumListCount}"/>
        <section-iterate name="Each" list="enumList" entry="enumRow"><widgets><label text="${enumRow.enumId}"/></widgets></section-iterate>
        <form-list name="EnumList" list="enumList">
            <entity-find entity-name="moqui.basic.Enumeration"><order-by field-name="enumId"/></entity-find>
            <field name="enumId"><default-field><display/></default-field></field>
        </form-list>
    </widgets>
</screen>
