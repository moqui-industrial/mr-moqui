<entities>
    <entity entity-name="Process" package="test.osiris">
        <field name="processId" type="id" is-pk="true"/>
        <field name="text" type="text-long"/>
        <relationship type="many" related="test.osiris.Phrase" short-alias="phrases"><key-map field-name="processId"/></relationship>
        <relationship type="many" related="test.osiris.Phrase" title="ReadOnly" short-alias="readOnlyPhrases" mutable="false"><key-map field-name="processId"/></relationship>
        <master name="default"><detail relationship="phrases"><detail relationship="links"/></detail></master>
    </entity>
    <entity entity-name="Phrase" package="test.osiris">
        <field name="phraseId" type="id" is-pk="true"/>
        <field name="processId" type="id"/>
        <field name="startChar" type="number-integer"/>
        <relationship type="one" related="test.osiris.Process"><key-map field-name="processId"/></relationship>
        <relationship type="many" related="test.osiris.Link" short-alias="links"><key-map field-name="phraseId" related-field-name="toPhraseId"/></relationship>
    </entity>
    <entity entity-name="Link" package="test.osiris">
        <field name="fromPhraseId" type="id" is-pk="true"/>
        <field name="toPhraseId" type="id" is-pk="true"/>
        <field name="action" type="id" is-pk="true"/>
        <relationship type="one" related="test.osiris.Phrase"><key-map field-name="toPhraseId" related-field-name="phraseId"/></relationship>
    </entity>
</entities>
