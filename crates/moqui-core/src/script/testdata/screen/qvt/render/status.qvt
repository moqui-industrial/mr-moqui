<m-status-bar id="SyncStatus" :bar="{'current':{'statusId':'EsRunning','label':'Running','color':'primary'},'stages':[{'statusId':'EsNotStarted','label':'Not Started','color':'grey-7','state':'done'},{'statusId':'EsRunning','label':'Running','color':'primary','state':'current'},{'statusId':'EsComplete','label':'Complete','color':'positive','state':'todo'}],'transitions':[{'toStatusId':'EsComplete','label':'Complete','color':'positive','isNext':true,'isDanger':false},{'toStatusId':'EsNotStarted','label':'Reset Not Started','color':'grey-7','isNext':false,'isDanger':false},{'toStatusId':'EsOtherError','label':'Error','color':'negative','isNext':false,'isDanger':true}]}" action="/setStatus" :parameters="{'entitySyncId':'S1'}" title="Sync S1"></m-status-bar>
<m-status-bar id="ReadOnly" :bar="{'current':{'statusId':'EsRunning','label':'Running','color':'primary'},'stages':[{'statusId':'EsNotStarted','label':'Not Started','color':'grey-7','state':'done'},{'statusId':'EsRunning','label':'Running','color':'primary','state':'current'},{'statusId':'EsComplete','label':'Complete','color':'positive','state':'todo'}],'transitions':[]}"></m-status-bar>
<m-status-bar id="Staged" :bar="{'current':{'statusId':'EsOtherError','label':'Other Error','color':'negative'},'stages':[{'statusId':'EsNotStarted','label':'Not Started','color':'grey-7','state':'todo'},{'statusId':'EsRunning','label':'Running','color':'primary','state':'todo'},{'statusId':'EsComplete','label':'Complete','color':'positive','state':'todo'},{'statusId':'EsOtherError','label':'Other Error','color':'negative','state':'current'}],'transitions':[{'toStatusId':'EsRunning','label':'Running','color':'primary','isNext':true,'isDanger':false}]}" action="/setStatus" :parameters="{}" :confirm="false"></m-status-bar>
<m-status-bar id="Allowed" :bar="{'current':{'statusId':'EsRunning','label':'Running','color':'primary'},'stages':[{'statusId':'EsNotStarted','label':'Not Started','color':'grey-7','state':'done'},{'statusId':'EsRunning','label':'Running','color':'primary','state':'current'},{'statusId':'EsComplete','label':'Complete','color':'positive','state':'todo'}],'transitions':[{'toStatusId':'EsComplete','label':'Complete','color':'positive','isNext':true,'isDanger':false}]}" action="/setStatus" :parameters="{}" parameter-name="toStatusId"></m-status-bar>
