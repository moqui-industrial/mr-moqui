<screen require-authentication="false">
    <actions>
        <set field="raw" value="a {{b}} c"/>
        <set field="fv" from="{note: 'x {{y}}', pick: 'A'}"/>
    </actions>
    <widgets>
        <label text="${raw}" type="p"/>
        <label text="{{literal}}"/>
        <link url="." text="go ${raw}" link-type="anchor"/>
        <form-single name="Braces" map="fv" transition=".">
            <field name="note"><default-field title="Note {{t}}"><text-line/></default-field></field>
            <field name="pick"><default-field><display text="shown ${raw}"/></default-field></field>
        </form-single>
    </widgets>
</screen>
