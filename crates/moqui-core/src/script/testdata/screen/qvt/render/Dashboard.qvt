<div id="Counters" class="m-dashboard counters" style="--m-dashboard-min:160px"><div class="m-dashboard-item"><m-number-card title="Open orders" value="42" delta="+3" icon="sym_o_receipt_long" href="/Orders?statusId=Open"></m-number-card>
</div><div class="m-dashboard-item"><m-number-card title="Late shipments" value="3" delta="+1" delta-good="down" href="https://example.com/late" external size="lg"></m-number-card>
</div><div class="m-dashboard-item"></div><div class="m-dashboard-item"><m-number-card id="Revenue" title="Revenue {{x}} &amp; more" value="$1,200" delta="-5%" icon="fa fa-dollar" size="sm" class="wide"></m-number-card>
</div><div class="m-dashboard-item"><span class="text-inline">not a card</span>
</div></div>
<div class="m-dashboard"><div class="m-dashboard-item"><m-number-card title="Plain" value="7"></m-number-card>
</div></div>
<m-link href="/Orders?sort=-date&amp;statusId=Open" class="m-link-text">All open</m-link>
