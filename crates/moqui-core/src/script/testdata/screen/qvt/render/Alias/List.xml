<?xml version="1.0" encoding="UTF-8"?>
<screen require-authentication="false">
    <transition name="detail">
        <default-response url="../Detail"><parameter name="fromResponse" value="yes"/></default-response>
    </transition>
    <transition name="acted">
        <actions><set field="x" value="1"/></actions>
        <default-response url="../Detail"/>
    </transition>
    <actions>
        <set field="rowList" from="[{id: 'I1'}]"/>
    </actions>
    <widgets>
        <form-list name="Rows" list="rowList" skip-form="true" paginate="false">
            <field name="id">
                <default-field>
                    <link text="${id}" url="detail" link-type="anchor"><parameter name="id"/></link>
                </default-field>
            </field>
            <field name="stay">
                <default-field>
                    <link text="Stay" url="detail" link-type="anchor" expand-transition-url="false"><parameter name="id"/></link>
                </default-field>
            </field>
            <field name="acted">
                <default-field>
                    <link text="Acted" url="acted" link-type="anchor"><parameter name="id"/></link>
                </default-field>
            </field>
            <field name="go">
                <default-field>
                    <link text="Go" url="detail" link-type="hidden-form-link"><parameter name="id"/></link>
                </default-field>
            </field>
            <field name="post">
                <default-field>
                    <link text="Post" url="detail" link-type="hidden-form-link" expand-transition-url="false"><parameter name="id"/></link>
                </default-field>
            </field>
        </form-list>
    </widgets>
</screen>
