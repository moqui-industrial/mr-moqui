<screen require-authentication="false">
    <transition name="add"><default-response type="none"/></transition>
    <transition name="load"><default-response type="none"/></transition>
    <transition name="edit"><default-response type="none"/></transition>
    <transition name="one"><default-response type="none"/></transition>
    <transition name="two"><default-response type="none"/></transition>
    <transition name="treeItems"><default-response type="none"/></transition>
    <transition name="save"><default-response type="none"/></transition>
    <transition name="go"><default-response type="none"/></transition>
    <transition name="open"><default-response type="none"/></transition>
    <actions>
        <set field="name" value="Ada"/>
        <set field="allowed" from="true"/>
        <set field="rowId" value="R7"/>
    </actions>
    <widgets>
        <container type="section" id="Wrap" style="wide"><label text="in wrap" type="h4" style="text-strong"/></container>
        <container-box type="info">
            <box-header title="Boxed ${name}"/>
            <box-toolbar><link url="add" text="Add" link-type="anchor"/></box-toolbar>
            <box-body height="200"><label text="body"/></box-body>
        </container-box>
        <container-row style="gap">
            <row-col xs="12" md="6"><label text="one"/></row-col>
            <row-col xs="12" md="6" style="end"><label text="two"/></row-col>
        </container-row>
        <container-panel id="Pan">
            <panel-header><label text="head"/></panel-header>
            <panel-left size="120"><label text="left"/></panel-left>
            <panel-center><label text="center"/></panel-center>
        </container-panel>
        <container-dialog id="Dlg" button-text="Open" icon="fa fa-plus" condition="allowed" width="500"><label text="dialog body"/></container-dialog>
        <dynamic-container id="Dyn" transition="load"><parameter name="p" value="1"/></dynamic-container>
        <dynamic-dialog id="DynDlg" button-text="Edit" transition="edit"><parameter name="id" from="rowId"/></dynamic-dialog>
        <button-menu text="Actions" icon="fa fa-cog" btn-type="info">
            <link url="one" text="One" link-type="anchor"/>
            <link url="two" text="Two" link-type="anchor" confirmation="Sure?"/>
        </button-menu>
        <tree name="Nodes" transition="treeItems" open-path="a/b"><parameter name="root" value="a"/></tree>
        <editable id="Ed" transition="save" text="${name}" parameter-name="name"/>
        <link url="go" text="Go &amp; see" btn-type="success" icon="fa fa-go" badge="3" tooltip="Go now" target-window="_blank" link-type="anchor-button"/>
        <link url="http://example.com/x" url-type="plain" text="Out" link-type="anchor"/>
        <label text="Line ${name}" type="p" condition="name" style="muted" tooltip="tip"/>
        <label text="a &lt; b&#10;next"/>
        <image url="/img.png" url-type="plain" alt="Logo" width="20" height="20" style="logo"/>
        <text type="html"><![CDATA[<b>raw</b>]]></text>
        <text template="true"><![CDATA[<i>${html(name)}</i>]]></text>
        <container-dialog id="TipDlg" button-text="Add" icon="fa fa-plus" tooltip="Add for ${name}"><label text="tip body"/></container-dialog>
        <link url="save" text="Mark done" link-type="hidden-form-link" background-reload-id="Dyn" background-hide-id="Dlg" background-message="Saved ${name}"/>
    </widgets>
</screen>
