<entities>
    <entity entity-name="Parent" package="test.graph">
        <field name="parentId" type="id" is-pk="true"/>
        <field name="lookupCode" type="id"/>
        <relationship type="many" related="test.graph.Child" short-alias="children"><key-map field-name="parentId"/></relationship>
        <relationship type="many" related="test.graph.Child" title="ReadOnly" short-alias="readOnlyChildren" mutable="false"><key-map field-name="parentId"/></relationship>
        <relationship type="one" related="test.graph.Lookup" short-alias="lookup" mutable="true"><key-map field-name="lookupCode" related-field-name="code"/></relationship>
        <relationship type="one" related="test.graph.Lookup" title="ReadOnly" short-alias="readOnlyLookup"><key-map field-name="lookupCode" related-field-name="code"/></relationship>
        <master name="default"><detail relationship="children"><detail relationship="edges"/></detail></master>
    </entity>
    <entity entity-name="Child" package="test.graph">
        <field name="childId" type="id" is-pk="true"/>
        <field name="parentId" type="id"/>
        <field name="position" type="number-integer"/>
        <relationship type="one" related="test.graph.Parent"><key-map field-name="parentId"/></relationship>
        <relationship type="many" related="test.graph.Edge" short-alias="edges"><key-map field-name="childId" related-field-name="targetChildId"/></relationship>
    </entity>
    <entity entity-name="Edge" package="test.graph">
        <field name="sourceChildId" type="id" is-pk="true"/>
        <field name="targetChildId" type="id" is-pk="true"/>
        <field name="kind" type="id" is-pk="true"/>
        <relationship type="one" related="test.graph.Child"><key-map field-name="targetChildId" related-field-name="childId"/></relationship>
    </entity>
    <entity entity-name="Lookup" package="test.graph">
        <field name="code" type="id" is-pk="true"/>
    </entity>
    <entity entity-name="Reference" package="test.graph">
        <field name="referenceId" type="id" is-pk="true"/>
        <field name="parentReferenceId" type="id"/>
        <relationship type="many" related="test.graph.Reference" short-alias="children">
            <key-map field-name="referenceId" related-field-name="parentReferenceId"/>
        </relationship>
        <master name="default"><detail relationship="children"/></master>
    </entity>
</entities>
