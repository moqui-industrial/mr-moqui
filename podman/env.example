# Copy to podman/.env. `podman compose` reads that file when the project directory is podman/.
# These are local defaults, the same shape as the Java compose files. Change them before a
# shared or production host. podman/.env is gitignored.

MOQUI_DB_NAME=moqui
MOQUI_DB_USER=moqui
MOQUI_DB_PASSWORD=moqui

# MySQL's root account. The server connects as MOQUI_DB_USER, not root.
MOQUI_DB_ROOT_PASSWORD=moquiroot

# Leave unset to let the first start generate entity_ds_crypt_pass into the data volume's env file.
# Set it only when this instance must use a password you already have (a moved database). The
# compose files pass it as entity_ds_crypt_pass; empty means the generated one is used.
# MOQUI_CRYPT_PASS=
