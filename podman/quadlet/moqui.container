# The single-container stack (podman/moqui-compose.yml) as a systemd service.
# Copy this file and moqui-data.volume to ~/.config/containers/systemd/ (rootless) or
# /etc/containers/systemd/ (root), then:
#   systemctl --user daemon-reload
#   systemctl --user start moqui.service
# The image is local: podman/build.sh. Pull=never so start does not try to fetch it.

[Unit]
Description=MR Moqui
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/moqui:latest
Pull=never
PublishPort=8080:8080
PublishPort=8443:8443
Volume=moqui-data.volume:/var/lib/moqui
Environment=instance_purpose=production
Notify=true
StopTimeout=60
HealthCmd=curl -fsS http://127.0.0.1:8080/health
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=120s
HealthRetries=5

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=70

[Install]
WantedBy=default.target
