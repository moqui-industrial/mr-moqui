<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <!-- The daily notification digest (org.moqui.impl.NotificationServices.send#UserNotificationDigest): notificationList
        (title, link, topicDescription, sentText, type), notificationCount, userFullName. A link becomes a full URL as in
        NotificationEmail.xml. -->
    <actions>
        <script><![CDATA[
            let baseUrl = ''
            if (webHostName) {
                baseUrl = 'https://' + webHostName
            } else {
                const rootUrl = ec.web.getWebappRootUrl(sri?.webappName || 'webroot', null, true, false)
                if (rootUrl && !rootUrl.includes('localhost')) baseUrl = rootUrl
            }
            digestRows = (notificationList || []).map((nm) => {
                let linkUrl = nm.link || ''
                if (linkUrl && !linkUrl.startsWith('http') && baseUrl)
                    linkUrl = baseUrl.replace(/\/$/, '') + (linkUrl.startsWith('/') ? '' : '/') + linkUrl
                return Object.assign({}, nm, {linkUrl: linkUrl})
            })
            digestTitle = ec.l10n.localize('Your notifications') + ' (' + (notificationCount || digestRows.length) + ')'
        ]]></script>
    </actions>
    <widgets><render-mode>
        <text type="html"><![CDATA[
<html><body>
    <h2>${html(digestTitle)}</h2>
    <#if userFullName><p>${html(userFullName)}</p></#if>
    <#list digestRows as nm>
    <p><#if nm.linkUrl.startsWith("http")><a href="${html(nm.linkUrl)}">${html(nm.title)}</a><#else>${html(nm.title)}</#if><br>
        <small>${html(nm.topicDescription ?? "")} &#183; ${html(nm.sentText ?? "")}</small></p>
    </#list>
</body></html>
        ]]></text>
        <text type="text"><![CDATA[
${digestTitle}

<#list digestRows as nm>
${nm.title}
  ${nm.topicDescription ?? ""} - ${nm.sentText ?? ""}<#if nm.linkUrl>
  ${nm.linkUrl}</#if>

</#list>
        ]]></text>
    </render-mode></widgets>
</screen>
