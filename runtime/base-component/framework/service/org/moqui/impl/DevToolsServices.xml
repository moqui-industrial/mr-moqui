<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <!-- The framework's development tools (crates/moqui-core/src/devtools; plans/design-dev-aide.md 17), for the
        dev-aide component, the command line and agents outside the server. Each answers only when instance_purpose is
        dev, for a user with the DEV_AIDE permission or in the ADMIN group. -->
    <service verb="restart" noun="Server" type="rust" location="moqui_core::service::devtools::restart_server"
            allow-remote="false">
        <description>Shut the server down gracefully, as on SIGTERM, and run it again with the same arguments: the
            fallback for what does not reload (an entity change, a conf or component change). Sessions and the sim
            overlay are lost. Answers at once; the shutdown waits for open requests.</description>
        <out-parameters><parameter name="restarting" type="Boolean"/></out-parameters>
    </service>
</services>
