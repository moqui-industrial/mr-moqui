<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="IngestKey" package="moqui.monitor" use="configuration" cache="never">
        <field name="keyId" type="text-medium" is-pk="true"/>
        <field name="userId" type="id"/>
        <field name="source" type="text-medium"/>
        <field name="createdDate" type="date-time"/>
        <field name="expiresDate" type="date-time"/>
        <field name="lastSeen" type="date-time"/>
        <field name="revoked" type="text-indicator"/>
        <relationship type="one" related="moqui.security.UserAccount"/>
    </entity>
</entities>
