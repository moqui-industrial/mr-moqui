<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <!-- A service implemented in Rust: the location is the function the component's catalogue binds (src/services.rs).
        The XML defines the service; the Rust function is only its body. -->
    <service verb="echo" noun="Message" type="rust" location="example::services::echo">
        <in-parameters><parameter name="message" required="true"/></in-parameters>
        <out-parameters><parameter name="message"/><parameter name="username"/></out-parameters>
    </service>

    <!-- A body the tool factory binds as a closure over its own state, in pre_facade_init (src/example_tool.rs). -->
    <service verb="get" noun="CounterValue" type="rust" location="example::counter_value">
        <out-parameters><parameter name="count" type="Long"/></out-parameters>
    </service>

    <!-- XML Actions using the tool: kept in a field, then called. -->
    <service verb="greet" noun="WithTool">
        <in-parameters><parameter name="name"/><parameter name="greeting"/></in-parameters>
        <out-parameters><parameter name="text"/><parameter name="count" type="Long"/></out-parameters>
        <actions>
            <set field="tool" from="ec.factory.getTool('ExampleTool', greeting)"/>
            <set field="text" from="tool.greet(name)"/>
            <set field="count" from="tool.counter().increment()"/>
        </actions>
    </service>

    <!-- A palette source of the suite shell (the shell-providers of screen/Gallery.xml), run by the shellSearch transition of
        webroot.xml: enumerations whose id or description has the text, linked to the Detail gallery screen. The contract of a
        palette source is in webroot/screen/webroot/js/README.md ("Shell data and providers"). -->
    <service verb="search" noun="GalleryEnumerations">
        <in-parameters>
            <parameter name="text" required="true"/>
            <parameter name="limit" type="Integer" default="5"/>
            <parameter name="docTypes" type="List"/>
            <parameter name="idMatch" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="rows" type="List"/>
            <parameter name="moreUrl"/>
        </out-parameters>
        <actions>
            <entity-find entity-name="moqui.basic.Enumeration" list="enumList" limit="50">
                <econditions combine="or">
                    <econdition field-name="enumId" operator="like" value="%${text}%" ignore-case="true"/>
                    <econdition field-name="description" operator="like" value="%${text}%" ignore-case="true"/>
                </econditions>
                <order-by field-name="description"/>
            </entity-find>
            <script><![CDATA[
                rows = enumList.map((row) => ({ title: row.description || row.enumId, subtitle: `${row.enumTypeId} · ${row.enumId}`,
                    icon: 'sym_o_label', url: '/qapps/gallery/Detail?enumId=' + encodeURIComponent(row.enumId) })).slice(0, limit || 5)
                moreUrl = '/qapps/gallery/List?description=' + encodeURIComponent(text)
            ]]></script>
        </actions>
    </service>
</services>
