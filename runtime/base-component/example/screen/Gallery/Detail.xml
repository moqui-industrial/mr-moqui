<!-- Gallery screen for the 3.3 Detail archetype of the IronStone BOSS style guide: one moqui.basic.Enumeration with a
    title row (identifier, status bar, primary action, secondary actions), boxes for its parts and a Chatter column.
    Every action posts to a no-op transition; nothing is written. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Detail" default-menu-index="3">

    <parameter name="enumId"/>

    <transition name="list"><default-response url="../List"/></transition>
    <transition name="record360"><default-response url="../Record360"/></transition>
    <transition name="advanceStatus">
        <actions><message>Gallery: ${enumId} would move to "${toStatus}"; nothing is written.</message></actions>
        <default-response url="."/>
    </transition>
    <transition name="holdRecord">
        <actions><message>Gallery: ${enumId} would be put on hold; nothing is written.</message></actions>
        <default-response url="."/>
    </transition>
    <transition name="cloneRecord">
        <actions><message>Gallery: ${enumId} would be cloned; nothing is written.</message></actions>
        <default-response url="."/>
    </transition>
    <transition name="retireRecord">
        <actions><message>Gallery: ${enumId} would be retired; nothing is written.</message></actions>
        <default-response url="."/>
    </transition>
    <transition name="postMessage">
        <actions><message>Gallery: Chatter is not built yet; the message "${messageText}" was not saved.</message></actions>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- without a parameter show a real record: the first screen theme type (framework seed data) -->
        <if condition="!enumId">
            <entity-find entity-name="moqui.basic.Enumeration" list="defaultEnumList" offset="0" limit="1">
                <econdition field-name="enumTypeId" value="ScreenThemeType"/>
                <order-by field-name="sequenceNum,enumId"/></entity-find>
            <set field="enumId" from="defaultEnumList[0]?.enumId"/>
        </if>
        <entity-find-one entity-name="moqui.basic.Enumeration" value-field="enumeration"/>
        <if condition="enumeration">
            <entity-find-one entity-name="moqui.basic.EnumerationType" value-field="enumType">
                <field-map field-name="enumTypeId" from="enumeration.enumTypeId"/></entity-find-one>
            <entity-find entity-name="moqui.basic.EnumerationAndType" list="siblingList" offset="0" limit="10">
                <econdition field-name="enumTypeId" from="enumeration.enumTypeId"/>
                <econdition field-name="enumId" operator="not-equals" from="enumId"/>
                <order-by field-name="sequenceNum,description"/></entity-find>
            <entity-find-count entity-name="moqui.basic.Enumeration" count-field="siblingCount">
                <econdition field-name="enumTypeId" from="enumeration.enumTypeId"/></entity-find-count>

            <!-- the status bar fallback: the stages of one status flow as chips, the second one marked current -->
            <entity-find entity-name="moqui.basic.StatusItem" list="statusItemAll">
                <order-by field-name="statusTypeId,sequenceNum,statusId"/></entity-find>
            <script><![CDATA[
                const byType = {}
                for (const item of statusItemAll) (byType[item.statusTypeId] = byType[item.statusTypeId] || []).push(item)
                const typeIds = Object.keys(byType).sort((a, b) => byType[b].length - byType[a].length || a.localeCompare(b))
                let stages = []
                if (byType.Order) stages = byType.Order
                else if (byType.OrderStatus) stages = byType.OrderStatus
                else if (typeIds.length) stages = byType[typeIds[0]]
                if (!stages.length) stages = [{ statusId: 'Created', description: 'Created' }, { statusId: 'Approved', description: 'Approved' },
                        { statusId: 'Shipped', description: 'Shipped' }, { statusId: 'Completed', description: 'Completed' }]
                stages = stages.slice(0, 6).map(s => ({ statusTypeId: String(s.statusTypeId || 'sample'), description: String(s.description || s.statusId || '') }))
                const currentIndex = Math.min(1, stages.length - 1)
                // bare assignments go to the screen context (as EntityDetail.xml does); context.x = ... does too
                statusTypeId = stages[0].statusTypeId
                currentStatus = stages[currentIndex].description
                nextStatus = currentIndex + 1 < stages.length ? stages[currentIndex + 1].description : ''
                let html = '<div class="row items-center no-wrap scroll q-gutter-x-xs">'
                stages.forEach((stage, i) => {
                    const text = WebUtilities.encodeHtml(stage.description)
                    if (i > 0) html += '<q-icon name="chevron_right" class="text-grey-6"></q-icon>'
                    if (i < currentIndex) html += '<q-chip dense square outline color="positive" icon="check">' + text + '</q-chip>'
                    else if (i === currentIndex) html += '<q-chip dense square color="primary" text-color="white">' + text + '</q-chip>'
                    else html += '<q-chip dense square outline color="grey-6">' + text + '</q-chip>'
                })
                statusBarHtml = html + '</div>'

                // the history box: an inline list, the framework keeps no change log for enumerations; a display
                // field formats an entity timestamp but not a plain number, so the dates are formatted here
                historyList = [
                    { when: ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd HH:mm'), who: ec.user.username, what: 'Opened in the gallery' },
                    { when: ec.l10n.format(enumeration.lastUpdatedStamp, 'yyyy-MM-dd HH:mm'), who: 'system', what: 'Loaded from seed data' } ]
            ]]></script>
        </if>
    </actions>
    <widgets>
        <container-box type="info"><box-header title="Archetype 3.3 Detail"/><box-body>
            <label type="p" text="One record with its parts and actions: a title row with the identifier, the status flow, one primary action and a menu of secondary actions; the parts as boxes (three or fewer, so no tabs) and Chatter at the right from 1440 px, below it on narrower screens. Read-only values are display fields with a label. Every action is a no-op here."/>
            <label type="p" text="Fallbacks for §8: status-bar is a row of q-chips over StatusItem rows of one type (${statusTypeId}) with the second stage marked current, until status-bar exists; chatter is a box with a compose form and a q-timeline of sample entries; the primary action is a link with the primary classes because a link outside a form is tonal."/>
        </box-body></container-box>

        <section name="NotFound" condition="!enumeration"><widgets>
            <container-box type="warning"><box-header title="Not found"/><box-body>
                <label type="p" text="There is no enumeration ${enumId}. The real screen goes back to the list with a notification."/>
                <link url="list" text="Back to the list"/>
            </box-body></container-box>
        </widgets></section>

        <section name="Found" condition="enumeration"><widgets>
            <!-- title row -->
            <container style="row items-center q-col-gutter-sm q-mx-sm q-mb-sm">
                <container style="col-12 col-md-auto">
                    <label text="${enumeration.description}" type="h5" style="q-my-none"/>
                    <label text="${enumId} · ${enumType?.description || enumeration.enumTypeId}" type="div" style="text-caption text-grey-6"/>
                </container>
                <container style="col-12 col-md">
                    <render-mode><text type="qvt"><![CDATA[${statusBarHtml}]]></text></render-mode>
                </container>
                <container style="col-12 col-md-auto row items-center q-gutter-x-sm no-wrap">
                    <link url="advanceStatus" text="Mark ${nextStatus}" btn-type="primary" condition="nextStatus"
                            confirmation="Move ${enumeration.description} from ${currentStatus} to ${nextStatus}?" parameter-map="{toStatus:nextStatus}"/>
                    <button-menu text="More" icon="fa fa-ellipsis-v">
                        <link url="holdRecord" text="Hold" link-type="hidden-form-link" confirmation="Put ${enumeration.description} on hold?"/>
                        <link url="cloneRecord" text="Clone" link-type="hidden-form-link"/>
                        <link url="retireRecord" text="Retire" link-type="hidden-form-link" btn-type="danger" confirmation="Retire ${enumeration.description}? This cannot be undone."/>
                        <link url="list" text="Back to the list" link-type="anchor"/>
                    </button-menu>
                </container>
            </container>

            <container-row>
                <row-col lg="8">
                    <container-box><box-header title="Header"/><box-body>
                        <form-single name="HeaderForm" map="enumeration" transition=".">
                            <field name="enumId"><default-field title="ID"><display/></default-field></field>
                            <field name="enumTypeId"><default-field title="Type"><display-entity entity-name="moqui.basic.EnumerationType"/></default-field></field>
                            <field name="description"><default-field title="Description"><display/></default-field></field>
                            <field name="enumCode"><default-field title="Code"><display/></default-field></field>
                            <field name="sequenceNum"><default-field title="Sequence"><display/></default-field></field>
                            <field name="parentEnumId"><default-field title="Parent">
                                <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description} [${enumId}]"/></default-field></field>
                            <field name="optionValue"><default-field title="Option value"><display/></default-field></field>
                            <field name="relatedEnumId"><default-field title="Related">
                                <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description} [${enumId}]"/></default-field></field>
                            <field name="lastUpdatedStamp"><default-field title="Last updated"><display format="yyyy-MM-dd HH:mm"/></default-field></field>
                            <field-layout>
                                <field-row><field-ref name="enumId"/><field-ref name="enumTypeId"/></field-row>
                                <field-row><field-ref name="description"/><field-ref name="enumCode"/></field-row>
                                <field-row><field-ref name="sequenceNum"/><field-ref name="parentEnumId"/></field-row>
                                <field-row><field-ref name="optionValue"/><field-ref name="relatedEnumId"/></field-row>
                                <field-row><field-ref name="lastUpdatedStamp"/></field-row>
                            </field-layout>
                        </form-single>
                    </box-body></container-box>

                    <container-box><box-header title="Related: ${siblingCount} of type ${enumType?.description || enumeration.enumTypeId}"/><box-toolbar>
                        <link url="list" text="All of this type" link-type="anchor" parameter-map="{enumTypeId:enumeration.enumTypeId}"/>
                    </box-toolbar><box-body-nopad>
                        <!-- the scroll class keeps a wide table inside its box on a phone -->
                        <container style="scroll">
                            <form-list name="SiblingList" list="siblingList" skip-form="true" paginate="false">
                                <field name="enumId"><default-field title="ID"><link url="." text="${enumId}"/></default-field></field>
                                <field name="description"><default-field title="Description"><display/></default-field></field>
                                <field name="enumCode"><default-field title="Code"><display/></default-field></field>
                                <field name="sequenceNum" align="right"><default-field title="Seq"><display/></default-field></field>
                            </form-list>
                        </container>
                    </box-body-nopad></container-box>

                    <container-box><box-header title="History"/><box-body-nopad>
                        <form-list name="HistoryList" list="historyList" skip-form="true" paginate="false">
                            <field name="when"><default-field title="When"><display/></default-field></field>
                            <field name="who"><default-field title="Who"><display/></default-field></field>
                            <field name="what"><default-field title="What"><display/></default-field></field>
                        </form-list>
                    </box-body-nopad></container-box>
                </row-col>
                <row-col lg="4">
                    <!-- chatter fallback: compose form over a no-op transition and a timeline of sample entries -->
                    <container-box><box-header title="Chatter"/><box-body>
                        <form-single name="ChatterCompose" transition="postMessage">
                            <field name="messageText"><default-field title="Message"><text-area rows="2" cols="40"/></default-field></field>
                            <field name="submitButton"><default-field title="Post"><submit/></default-field></field>
                        </form-single>
                        <render-mode><text type="qvt"><![CDATA[
<q-timeline color="primary" layout="dense">
    <q-timeline-entry title="John Doe set the status to ${WebUtilities.encodeHtml(currentStatus || '')}" subtitle="Today 09:12" icon="check_circle"></q-timeline-entry>
    <q-timeline-entry title="Note: description reviewed with the Products team" subtitle="Yesterday 16:40" icon="note"></q-timeline-entry>
    <q-timeline-entry title="Attached spec-sheet.pdf" subtitle="Last week" icon="attach_file" color="secondary"></q-timeline-entry>
    <q-timeline-entry title="Record loaded from seed data" subtitle="${ec.l10n.format(enumeration.lastUpdatedStamp, 'yyyy-MM-dd')}" icon="add_circle" color="grey-6"></q-timeline-entry>
</q-timeline>
                        ]]></text></render-mode>
                    </box-body></container-box>
                </row-col>
            </container-row>
        </widgets></section>
    </widgets>
</screen>
