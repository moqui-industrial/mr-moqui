<!-- The gallery's second quick-create kind (shell-providers in Gallery.xml), a .qvue screen and nothing else (render-modes="qvue"):
    QuickTask.qvue next to this file. The provider names it without .qvue, and the shell's dialog (an m-dynamic-container) loads it
    as qvue all the same (js/README.md, Loading a screen); a tray tab that names it does too. The component reads its own query
    through inject mScreen, confirms Discard with Quasar's Dialog plugin ($q.dialog), and refreshes itself in place when the tray
    refreshes its tab (shellRefresh). Saving is a no-op. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Gallery task" default-menu-include="false" render-modes="qvue">

    <!-- JSON with the message and no screenUrl: the quick-create dialog closes on it and the page under it stays -->
    <transition name="saveTask">
        <actions><script><![CDATA[
            const text = 'Gallery: the task "' + (taskName || '') + '" would be saved' + (recordId ? ' on ' + recordEntity + ' ' + recordId : '') + '; nothing is written.'
            ec.web.sendJsonResponse({messageInfos: [{message: text, type: 'success'}]})
        ]]></script></actions>
        <default-response type="none"/>
    </transition>

    <widgets>
        <render-mode>
            <text type="qvue" location="component://example/screen/Gallery/QuickTask.qvue" template="false"/>
        </render-mode>
    </widgets>
</screen>
