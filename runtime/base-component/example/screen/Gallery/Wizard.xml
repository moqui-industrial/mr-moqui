<!-- Gallery screen for the 3.10 Wizard archetype of the style guide: three steps driven by the step URL parameter.
    subscreens-panel type="wizard" is not supported (the XSD does not allow the value and the qvt macro writes a
    placeholder), so the stepper header is a q-stepper in raw qvt text and each step's form-single is a section below
    it; raw text and XML widgets cannot interleave inside one element. Nothing is written. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Wizard" default-menu-index="10">

    <parameter name="step"/>

    <transition name="wizardNext"><actions>
        <set field="nextStep" from="Math.min((Number(step) || 1) + 1, 3)"/>
        <message message="Step ${step} saved (gallery demo: nothing is written)"/>
    </actions><default-response url="."><parameter name="step" from="nextStep"/></default-response></transition>
    <transition name="wizardFinish"><actions>
        <message message="Customer ${customerName || ''} created (gallery demo: nothing is written)" type="success"/>
    </actions><default-response url="."><parameter name="step" value="1"/></default-response></transition>

    <actions>
        <set field="step" from="[1, 2, 3].includes(Number(step)) ? Number(step) : 1"/>
        <set field="wizard" from="{customerName: 'Acme Co.', contactName: 'Jane Doe', emailAddress: 'jane.doe@acme.example',
            phone: '+1 555 0100', countryGeoId: 'USA', currencyUomId: 'USD', newsletter: 'Y'}"/>
    </actions>
    <widgets>
        <container-box type="info"><box-header title="Archetype 3.10 Wizard"/><box-body>
            <label text="Multi-step creation: three steps driven by the step URL parameter, so the URL holds the step. Next is the primary submit of the step's form to a transition that answers with url=&quot;.&quot; and the next step; Back is a tonal link with the previous step; the last step is a review with one primary." type="p"/>
            <label text="Fallback: subscreens-panel type=&quot;wizard&quot; (§8) is not supported (the XSD does not allow the value and the macro writes a placeholder heading), so the stepper header is a q-stepper in raw qvt text and each step's form-single is a section below it. Entered values are not kept between steps because nothing is written." type="p"/>
        </box-body></container-box>

        <render-mode><text type="qvt"><![CDATA[
            <q-stepper model-value="${step}" flat bordered animated class="q-mb-md">
                <q-step name="1" title="Customer" caption="Name and contact" icon="person" active-icon="person" :done="${step > 1}">
                    <div class="text-body2">Step 1 of 3: who the customer is and how to reach them.</div></q-step>
                <q-step name="2" title="Options" caption="Country and preferences" icon="tune" active-icon="tune" :done="${step > 2}">
                    <div class="text-body2">Step 2 of 3: the country the customer trades from and what they want to receive.</div></q-step>
                <q-step name="3" title="Review" caption="Check and create" icon="check_circle" active-icon="check_circle" :done="false">
                    <div class="text-body2">Step 3 of 3: check the entries, then create the customer.</div></q-step>
            </q-stepper>
        ]]></text></render-mode>

        <section name="Step1" condition="step == 1"><widgets>
            <container-box><box-header title="1. Customer"/><box-body>
                <form-single name="WizardStep1" transition="wizardNext" map="wizard" focus-field="customerName">
                    <field name="step"><default-field><hidden default-value="1"/></default-field></field>
                    <field name="customerName"><default-field title="Customer name"><text-line size="40"/></default-field></field>
                    <field name="contactName"><default-field title="Contact"><text-line size="30"/></default-field></field>
                    <field name="emailAddress"><default-field title="Email"><text-line size="30" input-type="email"/></default-field></field>
                    <field name="phone"><default-field title="Phone"><text-line size="20"/></default-field></field>
                    <field name="nextButton"><default-field title="Next"><submit icon="arrow_forward"/></default-field></field>
                    <field-layout>
                        <field-ref name="step"/>
                        <field-row><field-ref name="customerName"/><field-ref name="contactName"/></field-row>
                        <field-row><field-ref name="emailAddress"/><field-ref name="phone"/></field-row>
                        <field-row-big><field-ref name="nextButton"/></field-row-big>
                    </field-layout>
                </form-single>
            </box-body></container-box>
        </widgets></section>

        <section name="Step2" condition="step == 2"><widgets>
            <container-box><box-header title="2. Options"/><box-body>
                <form-single name="WizardStep2" transition="wizardNext" map="wizard" focus-field="countryGeoId">
                    <field name="step"><default-field><hidden default-value="2"/></default-field></field>
                    <field name="countryGeoId"><default-field title="Country">
                        <drop-down><entity-options key="${geoId}" text="${geoName}">
                            <entity-find entity-name="moqui.basic.Geo">
                                <econdition field-name="geoTypeEnumId" value="GEOT_COUNTRY"/>
                                <order-by field-name="geoName"/></entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="currencyUomId"><default-field title="Currency">
                        <drop-down><entity-options key="${uomId}" text="${description} (${abbreviation})">
                            <entity-find entity-name="moqui.basic.Uom">
                                <econdition field-name="uomTypeEnumId" value="UT_CURRENCY_MEASURE"/>
                                <order-by field-name="description"/></entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="newsletter"><default-field title="Preferences">
                        <check><option key="Y" text="Send the monthly newsletter"/></check></default-field></field>
                    <field name="backLink"><default-field><link url="." text="Back" icon="arrow_back" parameter-map="{step: 1}"/></default-field></field>
                    <field name="nextButton"><default-field title="Next"><submit icon="arrow_forward"/></default-field></field>
                    <field-layout>
                        <field-ref name="step"/>
                        <field-row><field-ref name="countryGeoId"/><field-ref name="currencyUomId"/></field-row>
                        <field-ref name="newsletter"/>
                        <field-row-big><field-ref name="backLink"/><field-ref name="nextButton"/></field-row-big>
                    </field-layout>
                </form-single>
            </box-body></container-box>
        </widgets></section>

        <section name="Step3" condition="step == 3"><widgets>
            <container-box><box-header title="3. Review"/><box-body>
                <form-single name="WizardStep3" transition="wizardFinish" map="wizard">
                    <field name="step"><default-field><hidden default-value="3"/></default-field></field>
                    <field name="customerName"><default-field title="Customer name"><display/></default-field></field>
                    <field name="contactName"><default-field title="Contact"><display/></default-field></field>
                    <field name="emailAddress"><default-field title="Email"><display/></default-field></field>
                    <field name="phone"><default-field title="Phone"><display/></default-field></field>
                    <field name="countryGeoId"><default-field title="Country"><display-entity entity-name="moqui.basic.Geo" text="${geoName}"/></default-field></field>
                    <field name="currencyUomId"><default-field title="Currency"><display-entity entity-name="moqui.basic.Uom" text="${description} (${abbreviation})"/></default-field></field>
                    <field name="newsletter"><default-field title="Newsletter"><display text="${newsletter == 'Y' ? 'Yes, monthly' : 'No'}"/></default-field></field>
                    <field name="backLink"><default-field><link url="." text="Back" icon="arrow_back" parameter-map="{step: 2}"/></default-field></field>
                    <field name="finishButton"><default-field title="Create customer"><submit icon="check" confirmation="Create customer ${customerName}?"/></default-field></field>
                    <field-layout>
                        <field-ref name="step"/>
                        <field-row><field-ref name="customerName"/><field-ref name="contactName"/></field-row>
                        <field-row><field-ref name="emailAddress"/><field-ref name="phone"/></field-row>
                        <field-row><field-ref name="countryGeoId"/><field-ref name="currencyUomId"/></field-row>
                        <field-ref name="newsletter"/>
                        <field-row-big><field-ref name="backLink"/><field-ref name="finishButton"/></field-row-big>
                    </field-layout>
                </form-single>
            </box-body></container-box>
        </widgets></section>
    </widgets>
</screen>
