<!-- Dev AIDE Settings (plans/design-dev-aide.md 16): the site components (whose files the extend tier writes; the rest is
    upstream), "Allow editing upstream components" for a full-tier user (D17), the roots with their labels, read only
    flags and publish branches (question 15), roots of other directories, git init of a plain root, and network git on a
    shared dev server (an admin's). The services check the tier; the page shows what the user may change. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Settings" default-menu-index="9">

    <transition name="setSiteComponents"><service-call name="org.moqui.devaide.WorkspaceServices.set#Setting"
            in-map="{settingName: 'siteComponents', settingValue: siteComponents}"/>
        <actions><message type="success">Site components saved</message></actions>
        <default-response url="."/></transition>
    <transition name="setUpstreamEdits"><service-call name="org.moqui.devaide.WorkspaceServices.set#UpstreamEdits"
            in-map="{enabled: upstreamEdits == 'true'}"/>
        <default-response url="."/></transition>
    <transition name="setNetworkGit"><service-call name="org.moqui.devaide.WorkspaceServices.set#Setting"
            in-map="{settingName: 'networkGit', settingValue: networkGit == 'Y' ? 'Y' : 'N'}"/>
        <default-response url="."/></transition>
    <transition name="storeRoot"><service-call name="org.moqui.devaide.WorkspaceServices.store#Root"/>
        <actions><message type="success">Saved</message></actions>
        <default-response url="."/></transition>
    <transition name="deleteRoot"><service-call name="org.moqui.devaide.WorkspaceServices.delete#Root"/>
        <default-response url="."/></transition>
    <transition name="initRepository"><service-call name="org.moqui.devaide.VcsServices.init#Repository"/>
        <actions><message type="success">Initialized a git repository</message></actions>
        <default-response url="."/></transition>

    <actions>
        <service-call name="org.moqui.devaide.WorkspaceServices.get#Roots" out-map="info"/>
        <set field="roots" from="info.roots"/>
        <set field="full" from="info.tier == 'full'" type="Boolean"/>
        <set field="siteComponents" from="(info.siteComponents || []).join(', ')"/>
        <set field="upstreamEdits" from="info.upstreamEdits ? 'true' : 'false'"/>
    </actions>
    <widgets>
        <container-box id="DevAideSiteBox"><box-header title="Site components"/><box-body>
            <label type="p" text="The components this site owns, comma separated, the first the default target of an extension. Every other component is upstream: read only, and extended from the site component instead of edited."/>
            <form-single name="SiteComponentsForm" transition="setSiteComponents">
                <field name="siteComponents"><default-field title="Site components"><text-line size="50"/></default-field></field>
                <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
            </form-single>
        </box-body></container-box>

        <section name="UpstreamSection" condition="full"><widgets>
            <container-box id="DevAideUpstreamBox"><box-header title="Upstream components"/><box-body>
                <label type="p" text="Editing an upstream component in place is a fork: every upgrade of it has to merge your change. Turn this on to work on the framework or an app itself."/>
                <form-single name="UpstreamForm" transition="setUpstreamEdits">
                    <field name="upstreamEdits"><default-field title="Allow editing upstream components">
                        <radio><option key="false" text="No"/><option key="true" text="Yes"/></radio></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-single>
            </box-body></container-box>
        </widgets></section>

        <container-box id="DevAideRootsBox"><box-header title="Roots"/><box-body-nopad>
            <form-list name="RootSettings" list="roots" transition="storeRoot">
                <field name="location"><default-field><hidden default-value="${path}"/></default-field></field>
                <field name="id"><default-field title="Root"><display text="${label} (${kind == 'git' ? 'git' : 'Not a git repository'}${upstream ? ', upstream' : ''})"/></default-field></field>
                <field name="label"><default-field title="Label"><text-line size="16"/></default-field></field>
                <field name="readOnly"><default-field title="Read only"><check><option key="true" text=" "/></check></default-field></field>
                <field name="publishBranch"><default-field title="Publish branch"><text-line size="18"/></default-field></field>
                <field name="publishBranchRequired"><default-field title="Required"><check><option key="true" text=" "/></check></default-field></field>
                <field name="submitButton"><default-field title=""><submit text="Save"/></default-field></field>
                <field name="initGit"><default-field title="">
                    <link url="initRepository" text="Initialize git" parameter-map="{rootId: id}" link-type="hidden-form"
                            condition="kind != 'git' &amp;&amp; full" confirmation="Initialize a git repository in ${path}?"/>
                </default-field></field>
            </form-list>
        </box-body-nopad></container-box>

        <section name="AddRootSection" condition="full"><widgets>
            <container-box id="DevAideAddRootBox"><box-header title="Add a directory"/><box-body>
                <form-single name="AddRootForm" transition="storeRoot">
                    <field name="location"><default-field title="Directory (full path)"><text-line size="50"/></default-field></field>
                    <field name="label"><default-field title="Label"><text-line size="20"/></default-field></field>
                    <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                </form-single>
            </box-body></container-box>
        </widgets></section>

        <section name="SharedSection" condition="info.shared"><widgets>
            <container-box id="DevAideSharedBox"><box-header title="Shared dev server"/><box-body>
                <label type="p" text="On a shared dev server fetch, pull and push are off until an admin enables them; the server's git then uses its own credentials."/>
                <form-single name="NetworkGitForm" transition="setNetworkGit">
                    <field name="networkGit"><default-field title="Network git commands">
                        <radio><option key="N" text="Off"/><option key="Y" text="On"/></radio></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-single>
            </box-body></container-box>
        </widgets></section>
    </widgets>
</screen>
